# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit credentials.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_observatory
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_observatory_test

# Optional: directory where uploaded files are stored.
# Defaults to /tmp/data_observatory/uploads when unset.
UPLOAD_DIR=/tmp/data_observatory/uploads
